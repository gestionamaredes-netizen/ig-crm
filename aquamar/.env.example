# En desarrollo no hace falta ninguna de estas: la app arranca con valores por
# defecto y una base SQLite en ./data. Copiá este archivo a .env.local para
# cambiarlas.

# Clave del panel de administración (por defecto: aquamar)
ADMIN_PASSWORD=aquamar

# Secreto para firmar la cookie de sesión. Cambialo antes de publicar la app.
APP_SECRET=cambiame-en-produccion

# --- Desarrollo: base en un archivo local ---
# Ruta del archivo SQLite (por defecto: ./data/aquamar.sqlite)
DATABASE_FILE=./data/aquamar.sqlite

# --- Producción (Netlify u otro serverless): base alojada en Turso ---
# Si TURSO_DATABASE_URL está definida, la app la usa y DATABASE_FILE se ignora.
# En Netlify son obligatorias: el disco del servidor no sobrevive al pedido.
# TURSO_DATABASE_URL=libsql://tu-base.turso.io
# TURSO_AUTH_TOKEN=
