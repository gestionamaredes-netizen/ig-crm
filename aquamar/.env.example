# Todo tiene valor por defecto: la app arranca sin este archivo.
# Copialo a .env.local cuando quieras cambiar la clave de admin.

# Clave del panel de administración (por defecto: aquamar)
ADMIN_PASSWORD=aquamar

# Secreto para firmar la cookie de sesión. Cambialo antes de publicar la app.
APP_SECRET=cambiame-en-produccion

# Ruta del archivo SQLite (por defecto: ./data/aquamar.sqlite)
DATABASE_FILE=./data/aquamar.sqlite
