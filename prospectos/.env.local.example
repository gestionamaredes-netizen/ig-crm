# Copiá este archivo como .env.local para trabajar en tu máquina.
#
# Sin TURSO_DATABASE_URL la app usa un archivo SQLite local, que alcanza para
# desarrollo. En Netlify es obligatorio: el disco se borra entre pedidos.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# La clave que comparte el equipo comercial para entrar.
EQUIPO_PASSWORD=nexo

# Cadena larga y al azar; firma la cookie de sesión.
APP_SECRET=cambiame-por-algo-largo-y-al-azar
