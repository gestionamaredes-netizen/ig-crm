# Secretos: nunca deben salir del disco local.
# (web/.gitignore ya cubre lo suyo; esto protege cualquier carpeta nueva.)
.env
.env.*
!.env.*.example

# Dependencias y builds
node_modules/
.next/
dist/
build/

# Vercel
.vercel

# Sistema
.DS_Store
Thumbs.db
*.log

# Material de trabajo que no va al repo
demo/

# Intermedios de los generadores de PDF: se rehacen con cada build.
# Van por patrón y no carpeta por carpeta, así una carpeta nueva queda
# cubierta sin que haya que acordarse de sumarla acá.
__pycache__/
*.pyc
docs/**/.*.inlined.html
