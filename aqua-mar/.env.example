# Copiar como .env.local para desarrollo. En producción, cargar estos
# valores en Netlify → Site configuration → Environment variables.
# Todo valor NEXT_PUBLIC_ es visible en el navegador: nunca poner secretos.

NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Base de datos compartida del panel (guía: docs/SUPABASE.md).
# La anon key es pública por diseño; el acceso real lo controla RLS +
# login. El service_role de Supabase NUNCA va en variables NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
