# === Supabase ===
# Los sacás de: Supabase → tu proyecto → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY

# === Base de datos (Drizzle) ===
# Supabase → Project Settings → Database → Connection string → "Transaction pooler" (URI)
# Reemplazá [YOUR-PASSWORD] por la contraseña de la base que definiste al crear el proyecto.
DATABASE_URL=postgresql://postgres.TU-PROYECTO:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres

# === SEO Local (Google Places) ===
# Google Cloud → APIs y servicios → Credenciales → Crear credenciales → Clave de API.
# Antes habilitá "Places API (New)" en el proyecto.
# Restringí la clave a esa única API: sin restricción, cualquiera que la vea te consume el crédito.
# Sólo se lee desde el servidor. Nunca la pegues en un chat ni la subas al repo.
GOOGLE_PLACES_API_KEY=TU_CLAVE_DE_PLACES
